# Server
PORT=8080
NODE_ENV=production
FRONTEND_ORIGIN=https://your-domain.com

# Database (required to store enquiries)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/bhardwaj_orchards?retryWrites=true&w=majority
MONGODB_DB=bhardwaj_orchards

# Email notifications via Brevo's free transactional-email SMTP service
# Create an SMTP key in Brevo. Do not use your Brevo account password or API key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
# Verify this sender address in Brevo before deploying.
EMAIL_FROM=ankushworks09@gmail.com
CONTACT_TO=ankushworks09@gmail.com

# Recommended for Render Free: Brevo's HTTPS API avoids blocked SMTP ports.
# Generate this in Brevo under Settings > SMTP & API > API Keys & MCP.
BREVO_API_KEY=

# Optional payments — leave blank to keep the website enquiry-only.
# Use a merchant UPI ID, not a personal mobile number.
UPI_ID=
# Add Razorpay credentials only when payment checkout is ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
